  <h3>Performance</h3>
  <div class="table-wrap fade-up">
    <table>
      <thead>
        <tr>
          <th>Backend</th>
          <th data-type="number">pp512</th>
          <th data-type="number">tg128</th>
          <th>Flash attention</th>
        </tr>
